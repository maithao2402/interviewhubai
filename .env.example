# Copy this file to .env.local and fill in the values from your own Supabase
# project: Supabase dashboard -> Project Settings -> API Keys.
#
# The anon (publishable) key is safe to expose to the browser — every request
# made with it is still checked against Row Level Security. Never put the
# service_role (secret) key in a NEXT_PUBLIC_ variable: that key bypasses RLS
# entirely, and NEXT_PUBLIC_ values are compiled into the client bundle.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only needed to run `npm run verify:rls`, the manual RLS regression check.
# It signs in to two throwaway accounts (creating them on first run) and asserts
# that one user's interview data is unreachable from another's. Pick any
# password; these accounts own nothing but the rows the script creates and then
# deletes. Kept out of the script itself so no working credential is committed.
RLS_VERIFY_PASSWORD=choose-any-password-min-8-chars
