# Copy this file to .env.local and fill in the values from your own Supabase
# project: Supabase dashboard -> Project Settings -> API Keys.
#
# The anon (publishable) key is safe to expose to the browser — every request
# made with it is still checked against Row Level Security. Never put the
# service_role (secret) key in a NEXT_PUBLIC_ variable: that key bypasses RLS
# entirely, and NEXT_PUBLIC_ values are compiled into the client bundle.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
